# Only api.php is reachable from the web.
<FilesMatch "^(?!api\.php$).*">
    Require all denied
</FilesMatch>

# Let large uploads through (Hostinger may cap these lower on some plans).
<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value max_execution_time 600
</IfModule>
